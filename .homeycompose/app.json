{
  "id": "gpm.deye.solarpanel.tcp",
  "version": "1.3.19",
  "compatibility": ">=13.0.0",
  "sdk": 3,
  "runtime": "python",
  "pythonVersion": "3.14",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Deye Inverter (Local)"
  },
  "description": {
    "en": "Local integration for Deye inverters using Solarman V5 protocol (port 8899)",
    "nl": "Lokale integratie voor Deye-omvormers via Solarman V5-protocol (poort 8899)",
    "de": "Lokale Integration für Deye-Wechselrichter über Solarman V5-Protokoll (Port 8899)",
    "fr": "Intégration locale pour onduleurs Deye via le protocole Solarman V5 (port 8899)",
    "it": "Integrazione locale per inverter Deye tramite protocollo Solarman V5 (porta 8899)",
    "sv": "Lokal integration för Deye-växelriktare via Solarman V5-protokoll (port 8899)",
    "no": "Lokal integrasjon for Deye-vekselrettere via Solarman V5-protokoll (port 8899)",
    "es": "Integración local para inversores Deye mediante protocolo Solarman V5 (puerto 8899)",
    "da": "Lokal integration til Deye-invertere via Solarman V5-protokol (port 8899)",
    "pl": "Lokalna integracja dla falowników Deye przez protokół Solarman V5 (port 8899)"
  },
  "category": [
    "energy"
  ],
  "permissions": [
    "homey:manager:geolocation"
  ],
  "brandColor": "#E84D0E",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Gabriel Pedrosa Machado",
    "email": "g.machado@me.com"
  },
  "source": "https://github.com/gpmachado/gpm.deye.solarpanel.tcp",
  "homepage": "https://github.com/gpmachado/gpm.deye.solarpanel.tcp",
  "support": "https://github.com/gpmachado/gpm.deye.solarpanel.tcp/issues",
  "pythonPackages": [
    "astral"
  ],
  "flow": {
    "triggers": [
      {
        "id": "data_updated",
        "title": {
          "en": "Inverter data updated",
          "nl": "Omvormergegevens bijgewerkt",
          "de": "Wechselrichterdaten aktualisiert",
          "fr": "Données de l'onduleur mises à jour",
          "it": "Dati inverter aggiornati",
          "sv": "Växelriktardata uppdaterad",
          "no": "Vekselretter-data oppdatert",
          "es": "Datos del inversor actualizados",
          "da": "Inverterdata opdateret",
          "pl": "Dane falownika zaktualizowane"
        },
        "hint": {
          "en": "Triggered on every successful poll (every 60 s by default). Use tokens to read current values. Note: grid_power token is only populated for string inverters — on hybrid models, grid power is tracked by the Grid Meter device."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=deye&capabilities=meter_power.today"
          }
        ],
        "tokens": [
          {
            "name": "power",
            "type": "number",
            "title": {
              "en": "Power (W)"
            }
          },
          {
            "name": "daily_production",
            "type": "number",
            "title": {
              "en": "Daily Production (kWh)"
            }
          },
          {
            "name": "battery_soc",
            "type": "number",
            "title": {
              "en": "Battery SOC (%)"
            }
          },
          {
            "name": "grid_power",
            "type": "number",
            "title": {
              "en": "Grid Power (W)"
            }
          }
        ]
      },
      {
        "id": "grid_lost",
        "title": {
          "en": "Grid connection lost",
          "nl": "Netstroom verloren",
          "de": "Netzverbindung verloren",
          "fr": "Connexion au réseau perdue",
          "it": "Connessione alla rete persa",
          "sv": "Nätanslutning förlorad",
          "no": "Nettilkobling mistet",
          "es": "Conexión a la red perdida",
          "da": "Nettilslutning mistet",
          "pl": "Utrata połączenia z siecią"
        },
        "hint": {
          "en": "Triggered when the inverter reports a grid outage (hybrid models only)."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=deye&capabilities=measure_power.solar"
          }
        ]
      },
      {
        "id": "grid_restored",
        "title": {
          "en": "Grid connection restored",
          "nl": "Netstroom hersteld",
          "de": "Netzverbindung wiederhergestellt",
          "fr": "Connexion au réseau rétablie",
          "it": "Connessione alla rete ripristinata",
          "sv": "Nätanslutning återställd",
          "no": "Nettilkobling gjenopprettet",
          "es": "Conexión a la red restablecida",
          "da": "Nettilslutning genoprettet",
          "pl": "Połączenie z siecią przywrócone"
        },
        "hint": {
          "en": "Triggered when the inverter reports grid power has returned (hybrid models only)."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=deye&capabilities=measure_power.solar"
          }
        ]
      },
      {
        "id": "solar_production_started",
        "title": {
          "en": "Solar production started",
          "nl": "Zonneproductie gestart",
          "de": "Solarproduktion gestartet",
          "fr": "Production solaire démarrée",
          "it": "Produzione solare avviata",
          "sv": "Solproduktion startad",
          "no": "Solproduksjon startet",
          "es": "Producción solar iniciada",
          "da": "Solproduktion startet",
          "pl": "Produkcja solarna rozpoczęta"
        },
        "hint": {
          "en": "Triggered when the inverter starts producing power (e.g. at sunrise)."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=deye&capabilities=meter_power.today"
          }
        ],
        "tokens": [
          {
            "name": "power",
            "type": "number",
            "title": {
              "en": "Power (W)"
            }
          }
        ]
      },
      {
        "id": "solar_production_stopped",
        "title": {
          "en": "Solar production stopped",
          "nl": "Zonneproductie gestopt",
          "de": "Solarproduktion gestoppt",
          "fr": "Production solaire arrêtée",
          "it": "Produzione solare fermata",
          "sv": "Solproduktion stoppad",
          "no": "Solproduksjon stoppet",
          "es": "Producción solar detenida",
          "da": "Solproduktion stoppet",
          "pl": "Produkcja solarna zatrzymana"
        },
        "hint": {
          "en": "Triggered when the inverter stops producing power (e.g. at sunset or on a fault)."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=deye&capabilities=meter_power.today"
          }
        ]
      },
      {
        "id": "battery_charging_started",
        "title": {
          "en": "Battery started charging",
          "nl": "Batterij begon met opladen",
          "de": "Batterie begann zu laden",
          "fr": "La batterie a commencé à se charger",
          "it": "La batteria ha iniziato a caricarsi",
          "sv": "Batteriet började laddas",
          "no": "Batteriet begynte å lade",
          "es": "La batería empezó a cargarse",
          "da": "Batteriet begyndte at lade",
          "pl": "Bateria zaczęła się ładować"
        },
        "hint": {
          "en": "Triggered when the battery transitions from discharging/standby to charging."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=deye&capabilities=measure_power.battery"
          }
        ],
        "tokens": [
          {
            "name": "soc",
            "type": "number",
            "title": {
              "en": "Battery SOC (%)"
            }
          }
        ]
      },
      {
        "id": "battery_discharging_started",
        "title": {
          "en": "Battery started discharging",
          "nl": "Batterij begon te ontladen",
          "de": "Batterie begann zu entladen",
          "fr": "La batterie a commencé à se décharger",
          "it": "La batteria ha iniziato a scaricarsi",
          "sv": "Batteriet började urladdas",
          "no": "Batteriet begynte å lade ut",
          "es": "La batería empezó a descargarse",
          "da": "Batteriet begyndte at aflade",
          "pl": "Bateria zaczęła się rozładowywać"
        },
        "hint": {
          "en": "Triggered when the battery transitions from charging/standby to discharging."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=deye&capabilities=measure_power.battery"
          }
        ],
        "tokens": [
          {
            "name": "soc",
            "type": "number",
            "title": {
              "en": "Battery SOC (%)"
            }
          }
        ]
      },
      {
        "id": "grid_export_started",
        "title": {
          "en": "Grid export started",
          "nl": "Netinjectie gestart",
          "de": "Netzeinspeisung gestartet",
          "fr": "Injection sur le réseau démarrée",
          "it": "Inizio esportazione in rete",
          "sv": "Nätexport startad",
          "no": "Netteksport startet",
          "es": "Exportación a la red iniciada",
          "da": "Neteksport startet",
          "pl": "Eksport do sieci rozpoczęty"
        },
        "hint": {
          "en": "Triggered when the inverter starts feeding surplus power to the grid."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=deye&capabilities=meter_power.exported"
          }
        ],
        "tokens": [
          {
            "name": "power",
            "type": "number",
            "title": {
              "en": "Power (W)"
            }
          }
        ]
      },
      {
        "id": "grid_import_started",
        "title": {
          "en": "Grid import started",
          "nl": "Netstroom afname gestart",
          "de": "Netzbezug gestartet",
          "fr": "Importation du réseau démarrée",
          "it": "Inizio importazione dalla rete",
          "sv": "Nätimport startad",
          "no": "Nettimport startet",
          "es": "Importación de la red iniciada",
          "da": "Netimport startet",
          "pl": "Import z sieci rozpoczęty"
        },
        "hint": {
          "en": "Triggered when the system starts drawing power from the grid."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=deye&capabilities=meter_power.exported"
          }
        ],
        "tokens": [
          {
            "name": "power",
            "type": "number",
            "title": {
              "en": "Power (W)"
            }
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "is_battery_charging",
        "title": {
          "en": "Battery !{{is|is not}} charging",
          "nl": "Batterij !{{wordt|wordt niet}} opgeladen",
          "de": "Batterie !{{wird|wird nicht}} geladen",
          "fr": "La batterie !{{est|n'est pas}} en charge",
          "it": "La batteria !{{è|non è}} in carica",
          "sv": "Batteriet !{{laddas|laddas inte}}",
          "no": "Batteriet !{{lades|lades ikke}}",
          "es": "La batería !{{está|no está}} cargando",
          "da": "Batteriet !{{oplades|oplades ikke}}",
          "pl": "Bateria !{{ładuje się|nie ładuje się}}"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=deye&capabilities=measure_power.battery"
          }
        ]
      },
      {
        "id": "is_grid_feeding",
        "title": {
          "en": "Inverter !{{is|is not}} feeding power to the grid",
          "nl": "Omvormer !{{voedt|voedt niet}} het net",
          "de": "Wechselrichter !{{speist|speist nicht}} ins Netz",
          "fr": "L'onduleur !{{injecte|n'injecte pas}} sur le réseau",
          "it": "L'inverter !{{sta|non sta}} immettendo in rete",
          "sv": "Växelriktaren !{{matar|matar inte}} elnätet",
          "no": "Vekselretteren !{{mater|mater ikke}} nettet",
          "es": "El inversor !{{está|no está}} inyectando a la red",
          "da": "Inverteren !{{leverer|leverer ikke}} til nettet",
          "pl": "Falownik !{{zasila|nie zasila}} sieć"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=deye&capabilities=measure_power.grid"
          }
        ]
      },
      {
        "id": "is_solar_producing",
        "title": {
          "en": "Solar production !{{is|is not}} active",
          "nl": "Zonneproductie !{{is|is niet}} actief",
          "de": "Solarproduktion !{{ist|ist nicht}} aktiv",
          "fr": "La production solaire !{{est|n'est pas}} active",
          "it": "La produzione solare !{{è|non è}} attiva",
          "sv": "Solproduktion !{{är|är inte}} aktiv",
          "no": "Solproduksjon !{{er|er ikke}} aktiv",
          "es": "La producción solar !{{está|no está}} activa",
          "da": "Solproduktion !{{er|er ikke}} aktiv",
          "pl": "Produkcja solarna !{{jest|nie jest}} aktywna"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=deye&capabilities=meter_power.today"
          }
        ]
      },
      {
        "id": "battery_soc_above",
        "title": {
          "en": "Battery SOC !{{is|is not}} above",
          "nl": "Batterij SOC !{{is|is niet}} boven",
          "de": "Batterie-SOC !{{ist|ist nicht}} über",
          "fr": "SOC de la batterie !{{est|n'est pas}} au-dessus de",
          "it": "SOC batteria !{{è|non è}} sopra",
          "sv": "Batteriets SOC !{{är|är inte}} över",
          "no": "Batteri SOC !{{er|er ikke}} over",
          "es": "SOC de batería !{{está|no está}} por encima de",
          "da": "Batteri SOC !{{er|er ikke}} over",
          "pl": "SOC baterii !{{jest|nie jest}} powyżej"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=deye&capabilities=measure_battery"
          },
          {
            "type": "number",
            "name": "value",
            "min": 0,
            "max": 100
          }
        ]
      }
    ]
  }
}